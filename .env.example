# =============================================================================
# Whisperly API Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# For local overrides, use .env.local (takes priority over .env)
#
# Priority order:
#   1. .env.local (highest - for local development overrides)
#   2. .env (standard environment file)
#   3. System environment variables
# =============================================================================

# =============================================================================
# Database (Required)
# =============================================================================
# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://user:password@localhost:5432/whisperly

# =============================================================================
# Server (Optional)
# =============================================================================
# Port to run the API server on
# Default: 3000
PORT=3000

# =============================================================================
# Firebase Admin SDK (Required)
# =============================================================================
# Your Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Service account email from Firebase Console
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Private key from service account JSON (include the full key with newlines)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# =============================================================================
# Site Admin Access (Optional)
# =============================================================================
# Comma-separated list of email addresses for site admin access.
# Site admins bypass subscription/rate limit checks and can access admin features.
# Example: admin@example.com,another@example.com
SITEADMIN_EMAILS=

# =============================================================================
# Translation Service (Required)
# =============================================================================
# URL of the external translation service endpoint
# Example: http://localhost:8000/translate
TRANSLATION_SERVICE_URL=http://localhost:8000/translate

# Timeout in milliseconds for translation service requests
# Increase this value if translations are timing out for large documents
# Default: 120000 (2 minutes)
TRANSLATION_SERVICE_TIMEOUT=120000

# =============================================================================
# RevenueCat (Required for subscriptions/rate limiting)
# =============================================================================
# Secret API key from RevenueCat dashboard for subscription/entitlement checks
# Use the same key for production and sandbox - sandbox purchases are filtered
# based on the testMode query parameter passed to API endpoints
# Leave empty to disable subscription checks (uses free tier limits for everyone)
REVENUECAT_API_KEY=

# =============================================================================
# Email (Optional - Resend)
# =============================================================================
# API key from Resend dashboard for sending invitation emails
# Leave empty to disable invitation emails
RESEND_API_KEY=

# Sender email address (must be verified in Resend)
# Default: onboarding@resend.dev
RESEND_SENDER_EMAIL=

# Sender display name
# Default: Whisperly
RESEND_SENDER_NAME=

# App URL for email links (dashboard URL)
# Default: http://localhost:5173
APP_URL=

# =============================================================================
# Runtime Mode (Optional)
# =============================================================================
# Environment mode: development, production, or test
# Anything other than "production" enables dev-only behaviour (e.g. request docs)
NODE_ENV=development

# Bun environment mode (used alongside NODE_ENV for test detection)
BUN_ENV=

# =============================================================================
# Translation Tuning (Optional)
# =============================================================================
# Set to "true" to fall back to a mock translation when the translation
# service is unreachable. Never enable in production.
TRANSLATION_MOCK_FALLBACK=false

# How many times to retry a translation that came back with unresolved
# placeholders
# Default: 1
PLACEHOLDER_RETRY_ATTEMPTS=1

# =============================================================================
# Dictionary Cache (Optional)
# =============================================================================
# In-memory dictionary cache TTL, in milliseconds
# Default: 300000 (5 minutes)
DICTIONARY_CACHE_TTL_MS=300000

# Used by `bun run test:db`. Must point at localhost; the guard refuses any other host.
TEST_DATABASE_URL=postgresql://localhost:5432/whisperly_test
